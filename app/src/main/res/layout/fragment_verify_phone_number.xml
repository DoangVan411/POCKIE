<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    tools:context=".presentation.ui.authentication.verifyphonenumber.VerifyPhoneNumberFragment">

    <View
        android:id="@+id/back"
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:layout_constraintDimensionRatio="1:1"
        android:background="@drawable/ic_back"
        app:layout_constraintVertical_bias="0.02"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/guideline1"
        app:layout_constraintEnd_toEndOf="@id/guideline2"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/guideline1"
        app:layout_constraintEnd_toEndOf="@id/guideline2"
        app:layout_constraintHeight_percent="0.1"
        android:textColor="@color/white"
        app:layout_constraintVertical_bias="0.1"
        android:text="@string/verify_your_phone_number"
        android:gravity="center"
        android:fontFamily="@font/poppins_semibold"
        android:autoSizeMinTextSize="10dp"
        android:autoSizeMaxTextSize="25dp"
        android:autoSizeTextType="uniform"/>
    
    <LinearLayout
        android:id="@+id/otp_layout"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/guideline1"
        app:layout_constraintEnd_toEndOf="@id/guideline2"
        app:layout_constraintVertical_bias="0">
        
        <EditText
            android:id="@+id/opt_code_1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:textColor="@color/white"
            android:inputType="number"
            android:gravity="center"
            android:maxLength="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:hint="0"
            android:textColorHint="@color/gray_text"
            android:background="@drawable/background_field"
            android:imeOptions="actionNext"
            android:fontFamily="@font/poppins_medium" />

        <EditText
            android:background="@drawable/background_field"
            android:id="@+id/opt_code_2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="0"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:textColorHint="@color/gray_text"
            android:layout_height="match_parent"
            android:textColor="@color/white"
            android:inputType="number"
            android:gravity="center"
            android:maxLength="1"
            android:imeOptions="actionNext"
            android:fontFamily="@font/poppins_medium" />

        <EditText
            android:id="@+id/opt_code_3"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="0"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:textColorHint="@color/gray_text"
            android:background="@drawable/background_field"
            android:layout_height="match_parent"
            android:textColor="@color/white"
            android:inputType="number"
            android:gravity="center"
            android:maxLength="1"
            android:imeOptions="actionNext"
            android:fontFamily="@font/poppins_medium" />

        <EditText
            android:id="@+id/opt_code_4"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="0"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:textColorHint="@color/gray_text"
            android:background="@drawable/background_field"
            android:layout_height="match_parent"
            android:textColor="@color/white"
            android:inputType="number"
            android:gravity="center"
            android:maxLength="1"
            android:imeOptions="actionNext"
            android:fontFamily="@font/poppins_medium" />

        <EditText
            android:id="@+id/opt_code_5"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="0"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/background_field"
            android:textColorHint="@color/gray_text"
            android:layout_height="match_parent"
            android:textColor="@color/white"
            android:inputType="number"
            android:gravity="center"
            android:maxLength="1"
            android:imeOptions="actionNext"
            android:fontFamily="@font/poppins_medium" />

        <EditText
            android:id="@+id/opt_code_6"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:background="@drawable/background_field"
            android:hint="0"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:textColorHint="@color/gray_text"
            android:layout_height="match_parent"
            android:textColor="@color/white"
            android:inputType="number"
            android:gravity="center"
            android:maxLength="1"
            android:imeOptions="actionDone"
            android:fontFamily="@font/poppins_medium" />
    </LinearLayout>

    <TextView
        android:id="@+id/resend_otp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/otp_layout"
        app:layout_constraintBottom_toBottomOf="parent"
        android:text="@string/otp_resend"
        app:layout_constraintStart_toStartOf="@id/guideline1"
        app:layout_constraintEnd_toEndOf="@id/guideline2"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins_medium"
        app:layout_constraintVertical_bias="0.06"
        app:layout_constraintHeight_percent="0.04"
        android:gravity="center"/>

    <Button
        android:id="@+id/next"
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/resend_otp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/guideline1"
        app:layout_constraintEnd_toEndOf="@id/guideline2"
        app:layout_constraintWidth_percent="0.7"
        android:text="@string/Continue"
        android:textAllCaps="false"
        android:fontFamily="@font/poppins_semibold"
        android:background="@drawable/white_button"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95" />

</androidx.constraintlayout.widget.ConstraintLayout>