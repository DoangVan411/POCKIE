<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/cream_white"
    tools:context=".presentation.ui.mainapp.home.camera.CameraFragment">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewCamera"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.5"
        app:layout_constraintVertical_bias="0.1"
        app:layout_constraintWidth_percent="0.9">

        <androidx.camera.view.PreviewView
            android:id="@+id/camera"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.5"
        app:layout_constraintVertical_bias="0.1"
        app:layout_constraintWidth_percent="0.9"
        android:visibility="invisible">

        <ImageView
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/pockie"/>
    </androidx.cardview.widget.CardView>

    <EditText
        android:id="@+id/caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/cardViewCamera"
        app:layout_constraintEnd_toEndOf="@id/cardViewCamera"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintWidth_percent="0.8"
        android:hint="@string/add_a_caption"
        android:textColorHint="@color/gray_text"
        android:gravity="center"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins_medium"
        android:background="@drawable/background_caption"
        android:visibility="invisible"/>

    <View
        android:id="@+id/cancel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/take_photo"
        app:layout_constraintBottom_toBottomOf="@id/take_photo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/take_photo"
        android:background="@drawable/ic_cancel"
        app:layout_constraintHeight_percent="0.06"
        app:layout_constraintDimensionRatio="1:1"
        android:visibility="invisible"/>

    <View
        android:id="@+id/take_photo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/cardViewCamera"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/button_take_photo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.3"
        app:layout_constraintWidth_percent="0.5"
        app:layout_constraintHeight_percent="0.15"/>

    <View
        android:id="@+id/send"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/take_photo"
        app:layout_constraintBottom_toBottomOf="@id/take_photo"
        app:layout_constraintStart_toStartOf="@id/take_photo"
        app:layout_constraintEnd_toEndOf="@id/take_photo"
        android:background="@drawable/ic_send"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintHeight_percent="0.09"
        android:rotation="320"
        android:visibility="invisible"/>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/take_photo"
        app:layout_constraintBottom_toBottomOf="@id/take_photo"
        app:layout_constraintStart_toStartOf="@id/take_photo"
        app:layout_constraintEnd_toEndOf="@id/take_photo"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintHeight_percent="0.09"
        android:visibility="invisible"
        android:indeterminateTint="@color/lighter_pink"/>

    <View
        android:id="@+id/reverse"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/take_photo"
        app:layout_constraintBottom_toBottomOf="@id/take_photo"
        app:layout_constraintStart_toEndOf="@id/take_photo"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/ic_reverse"
        app:layout_constraintHeight_percent="0.06"
        app:layout_constraintDimensionRatio="1:1" />

    <TextView
        android:id="@+id/tvTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/take_photo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="@string/select_a_tag"
        android:textColor="@color/gray_text"
        android:fontFamily="@font/poppins_semibold"
        android:textSize="15sp"
        app:layout_constraintVertical_bias="0.1"
        app:layout_constraintHorizontal_bias="0.05"
        android:visibility="invisible"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tag_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tvTag"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0"
        android:visibility="invisible"/>

    <TextView
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/take_photo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.1"
        android:text="@string/history"
        android:textColor="@color/text_pink"
        android:fontFamily="@font/poppins_semibold"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="25sp"
        android:autoSizeTextType="uniform"
        android:gravity="center|bottom"
        app:layout_constraintVertical_bias="0"/>

    <View
        android:id="@+id/icon_history"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/ic_history"
        android:rotation="270"
        app:layout_constraintTop_toBottomOf="@id/text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintHeight_percent="0.05"
        app:layout_constraintVertical_bias="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>