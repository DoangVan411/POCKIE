<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/onboarding_graph"
    app:startDestination="@id/onboardingFragment">

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.example.pockie.presentation.ui.authentication.onboarding.OnboardingFragment"
        android:label="fragment_onboarding"
        tools:layout="@layout/fragment_onboarding" >
        <action
            android:id="@+id/action_onboardingFragment_to_emailFragment"
            app:destination="@id/emailFragment" />
        <action
            android:id="@+id/action_onboardingFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/emailFragment"
        android:name="com.example.pockie.presentation.ui.authentication.email.EmailFragment"
        android:label="fragment_email"
        tools:layout="@layout/fragment_email" >
        <argument
            android:name="status"
            app:argType="string" />
        <action
            android:id="@+id/action_emailFragment_to_passwordFragment"
            app:destination="@id/passwordFragment" />
    </fragment>
    <fragment
        android:id="@+id/passwordFragment"
        android:name="com.example.pockie.presentation.ui.authentication.password.PasswordFragment"
        android:label="fragment_password"
        tools:layout="@layout/fragment_password" >
        <argument
            android:name="status"
            app:argType="string" />
        <action
            android:id="@+id/action_passwordFragment_to_verifyPhoneNumberFragment"
            app:destination="@id/verifyPhoneNumberFragment" />
        <argument
            android:name="email"
            app:argType="string" />
        <action
            android:id="@+id/action_passwordFragment_to_nameUserFragment"
            app:destination="@id/nameUserFragment" />
        <action
            android:id="@+id/action_passwordFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/verifyPhoneNumberFragment"
        android:name="com.example.pockie.presentation.ui.authentication.verifyphonenumber.VerifyPhoneNumberFragment"
        android:label="fragment_verify_phone_number"
        tools:layout="@layout/fragment_verify_phone_number" >
        <action
            android:id="@+id/action_verifyPhoneNumberFragment_to_passwordFragment"
            app:destination="@id/passwordFragment" />
        <argument
            android:name="status"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/nameUserFragment"
        android:name="com.example.pockie.presentation.ui.authentication.nameuser.NameUserFragment"
        android:label="fragment_name_user"
        tools:layout="@layout/fragment_name_user" >
        <argument
            android:name="email"
            app:argType="string" />
        <argument
            android:name="password"
            app:argType="string" />
        <action
            android:id="@+id/action_nameUserFragment_to_contactsFragment"
            app:destination="@id/contactsFragment" />
    </fragment>
    <fragment
        android:id="@+id/contactsFragment"
        android:name="com.example.pockie.presentation.ui.authentication.addcontacts.ContactsFragment"
        android:label="fragment_contacts"
        tools:layout="@layout/fragment_contacts" >
        <action
            android:id="@+id/action_contactsFragment_to_setUpFragment"
            app:destination="@id/setUpFragment" />
    </fragment>
    <fragment
        android:id="@+id/setUpFragment"
        android:name="com.example.pockie.presentation.ui.authentication.setup.SetUpFragment"
        android:label="fragment_set_up"
        tools:layout="@layout/fragment_set_up" >
        <action
            android:id="@+id/action_setUpFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.pockie.presentation.ui.mainapp.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_homeFragment_to_chatListFragment"
            app:destination="@id/chatListFragment" />
        <action
            android:id="@+id/action_homeFragment_to_notificationFragment"
            app:destination="@id/notificationFragment" />
        <action
            android:id="@+id/action_homeFragment_to_friendsFragment"
            app:destination="@id/friendsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_onboardingFragment"
            app:destination="@id/onboardingFragment" />
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.pockie.presentation.ui.mainapp.profile.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile" />
    <fragment
        android:id="@+id/chatListFragment"
        android:name="com.example.pockie.presentation.ui.mainapp.chat.chatlist.ChatListFragment"
        android:label="fragment_chat_list"
        tools:layout="@layout/fragment_chat_list" >
        <action
            android:id="@+id/action_chatListFragment_to_singleChatFragment"
            app:destination="@id/singleChatFragment" />
    </fragment>
    <fragment
        android:id="@+id/friendsFragment"
        android:name="com.example.pockie.presentation.ui.mainapp.friends.FriendsFragment"
        android:label="fragment_friends"
        tools:layout="@layout/fragment_friends" />
    <fragment
        android:id="@+id/notificationFragment"
        android:name="com.example.pockie.presentation.ui.mainapp.notification.NotificationFragment"
        android:label="fragment_notification"
        tools:layout="@layout/fragment_notification" />
    <fragment
        android:id="@+id/singleChatFragment"
        android:name="com.example.pockie.presentation.ui.mainapp.chat.singlechat.SingleChatFragment"
        android:label="SingleChatFragment" />


</navigation>